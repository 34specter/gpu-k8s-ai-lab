# Copy to a local environment file and validate before use.
# These values are lab-specific; do not treat them as universal defaults.
NCCL_DEBUG=INFO
NCCL_SOCKET_IFNAME=<roce-interface>
NCCL_IB_HCA=<ib-device>
NCCL_IB_GID_INDEX=<gid-index>
NCCL_IB_QPS_PER_CONNECTION=1
NCCL_MIN_NCHANNELS=1
NCCL_MAX_NCHANNELS=1
