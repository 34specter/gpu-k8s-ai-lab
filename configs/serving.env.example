# KubeRay + vLLM parameter template
SERVING_IMAGE=<registry>/<project>/<vllm-image>:<tag>
MODEL_NAME=Qwen/Qwen2.5-14B
MODEL_PATH=<shared-model-path>
TENSOR_PARALLEL_SIZE=2
RAY_VERSION=2.53
VLLM_VERSION=0.6.x
SERVICE_NAME=<service-name>
INGRESS_HOST=<api-hostname>
TLS_SECRET_NAME=<tls-secret-name>
OPENAI_API_BASE=http://<service-name>.<namespace>.svc.cluster.local:<port>/v1
