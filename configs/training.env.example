# Distributed training parameter template
TRAINING_IMAGE=<registry>/<project>/<training-image>:<tag>
MODEL_NAME=Qwen/Qwen2.5-1.5B
MODEL_PATH=<model-path>
OUTPUT_PATH=<output-path>
NNODES=2
NPROC_PER_NODE=1
MASTER_ADDR=<node-a-or-service-address>
MASTER_PORT=<unused-port>
NNODES_RANK=<rank-or-index-source>
DTYPE=<bf16-or-fp16>
LORA_RANK=<lora-rank>
